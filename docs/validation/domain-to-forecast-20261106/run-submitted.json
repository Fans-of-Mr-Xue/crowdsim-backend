odel\uff1b\u652f\u6301\u5355\u5c42\u8fde\u901a\u573a\u5730\uff0c\u4fdd\u7559\u5b8c\u6574\u7814\u7a76\u65f6\u6bb5\u3002\u91c7\u7528\u7f13\u5b58\u822a\u70b9\u5f15\u5bfc\uff0c\u8eab\u4f53\u8fd0\u52a8\u6b65\u957f 0.05 \u79d2\uff1b\u6309\u5b9e\u9645\u5728\u573a\u4eba\u6570\u3001\u8ba1\u7b97\u91cf\u3001\u8fd0\u884c\u8017\u65f6\u548c\u8f93\u51fa\u91cf\u7ba1\u7406\u9884\u7b97\u3002", "principle": "\u628a\u6bcf\u4e2a\u4eba\u653e\u8fdb\u53ef\u884c\u8d70\u7a7a\u95f4\uff0c\u671d\u76ee\u6807\u79fb\u52a8\u3002\u524d\u65b9\u7a7a\u95f4\u8db3\u591f\u5c31\u6309\u671f\u671b\u901f\u5ea6\u8d70\uff0c\u524d\u65b9\u6709\u4eba\u5c31\u6839\u636e\u51c0\u95f4\u8ddd\u51cf\u901f\uff1b\u8fd8\u4f1a\u8c03\u6574\u65b9\u5411\u907f\u8ba9\u4eba\u548c\u8fb9\u754c\u3002\u53ef\u4ee5\u89c2\u5bdf\u540c\u6837\u7684\u5ba2\u6d41\u5728\u72ed\u7a84\u6b65\u9053\u600e\u6837\u6392\u961f\u548c\u901a\u8fc7\u3002", "suitable_for": "\u5173\u6ce8\u4eba\u5982\u4f55\u8d70\u3001\u7a84\u901a\u9053\u600e\u6837\u6392\u961f\uff0c\u4ee5\u53ca\u907f\u8ba9\u673a\u5236\u5e26\u6765\u7684\u5bc6\u5ea6\u53d8\u5316\u65f6\u4f7f\u7528\u3002", "required_inputs": "\u5171\u540c\u8d44\u6599\u4e4b\u5916\uff0c\u5fc5\u987b\u80fd\u6784\u6210\u8fde\u7eed\u53ef\u884c\u8d70\u9762\u5e76\u6263\u9664\u969c\u788d\u7269\uff1b\u5165\u53e3\u3001\u76ee\u6807\u70b9\u5e94\u843d\u5728\u53ef\u8fbe\u7a7a\u95f4\u3002\u53ea\u6709\u5730\u56fe\u4e0a\u7684\u4e00\u6761\u7ebf\u6216\u573a\u5730\u5916\u6846\u4e0d\u591f\u3002\u5df2\u6709\u6b65\u9053\u53ca\u5bbd\u5ea6\u53ef\u7531\u540e\u7aef\u8f6c\u6362\uff0c\u4e0d\u5fc5\u91cd\u590d\u4e0a\u4f20\u3002", "outputs": ["\u9010\u4eba\u7684\u91c7\u6837\u4f4d\u7f6e\uff0c\u53ef\u64ad\u653e\u79fb\u52a8\u8fc7\u7a0b", "\u6309\u5171\u540c\u7f51\u683c\u6c47\u603b\u7684\u5bc6\u5ea6\u3001\u4eba\u6570\u548c\u901f\u5ea6", "\u5165\u53e3\u5916\u6392\u961f\u3001\u901a\u9053\u6d41\u91cf\u548c\u7d2f\u8ba1\u79bb\u573a\u91cf"], "parameter_keys": ["agent_radius_m", "cfs_time_gap_s"], "tradeoff": "\u6bd4\u5b88\u6052\u6cd5\u66f4\u7ec6\uff0c\u4f46\u66f4\u4f9d\u8d56\u51e0\u4f55\u548c\u4e2a\u4eba\u7a7a\u95f4\u53c2\u6570\u3002\u95f4\u8ddd\u65f6\u95f4\u8d8a\u5927\u901a\u5e38\u8d8a\u4fdd\u5b88\uff1b\u201c\u65e0\u78b0\u649e\u201d\u662f\u6a21\u578b\u8bbe\u8ba1\u76ee\u6807\uff0c\u4e0d\u4ee3\u8868\u5df2\u9a8c\u8bc1\u73b0\u573a\u5b89\u5168\u3002", "citation": "Tordeux, Chraibi & Seyfried (2015), Collision-free speed model for pedestrian dynamics, TGF\u201915, arXiv:1512.05597."}, {"id": "social_force", "name": "\u793e\u4f1a\u529b\u6a21\u578b SFM", "version": "1.1.1", "recommended": true, "engine": "JuPedSim 1.4.2", "description": "\u9010\u4eba\u8ba1\u7b97\u76ee\u6807\u9a71\u52a8\u548c\u4eba\u4e0e\u4eba\u3001\u4eba\u4e0e\u969c\u788d\u7269\u7684\u6392\u65a5\u4f5c\u7528\uff0c\u6a21\u62df\u901f\u5ea6\u53d8\u5316\u4e0e\u7ed5\u884c\u3002", "equation": "m\u00b7dv/dt=m(v\u2080e\u2212v)/\u03c4+\u03a3f\u4eba\u4e0e\u4eba+\u03a3f\u4eba\u4e0e\u5899", "source": "https://doi.org/10.1103/PhysRevE.51.4282", "implementation_source": "https://www.jupedsim.org/stable/pedestrian_models/index.html", "boundary": "\u8c03\u7528 JuPedSim SocialForceModel\uff08\u5e73\u6ed1\u6392\u65a5\u5b9e\u73b0\uff09\uff0c\u91c7\u7528 0.01 \u79d2\u79ef\u5206\u6b65\u957f\uff1b\u4e0d\u7528\u4e8e\u8ba1\u7b97\u8e29\u8e0f\u3001\u4eba\u4f53\u4f24\u5bb3\u6216\u771f\u5b9e\u6324\u538b\u529b\u3002\u8d44\u6e90\u9884\u7b97\u540c CFS\uff0c\u53c2\u6570\u5c1a\u672a\u8fdb\u884c\u73b0\u573a\u6807\u5b9a\u3002", "principle": "\u628a\u201c\u60f3\u5f80\u76ee\u6807\u8d70\u201d\u548c\u201c\u60f3\u4e0e\u522b\u4eba\u3001\u5899\u4f53\u4fdd\u6301\u8ddd\u79bb\u201d\u5199\u6210\u901f\u5ea6\u53d8\u5316\u89c4\u5219\uff0c\u6bcf\u4e00\u6b65\u66f4\u65b0\u4eba\u7684\u901f\u5ea6\u548c\u4f4d\u7f6e\u3002\u5b83\u4e0e CFS \u7528\u4e0d\u540c\u673a\u5236\u63cf\u8ff0\u907f\u8ba9\uff0c\u9002\u5408\u6bd4\u8f83\u540c\u4e00\u573a\u5730\u7684\u7ed5\u884c\u3001\u51cf\u901f\u548c\u805a\u96c6\u4f4d\u7f6e\u662f\u5426\u4e00\u81f4\u3002", "suitable_for": "\u4f5c\u4e3a\u7b2c\u4e8c\u79cd\u4e2a\u4f53\u8fd0\u52a8\u673a\u5236\uff0c\u4e0e CFS \u548c\u5b88\u6052\u57fa\u7ebf\u5e76\u6392\u6bd4\u8f83\uff1b\u68c0\u9a8c\u7ed3\u8bba\u5bf9\u6a21\u578b\u9009\u62e9\u662f\u5426\u654f\u611f\u3002", "required_inputs": "\u4e0e CFS \u5171\u7528\u53ef\u884c\u8d70\u9762\u3001\u969c\u788d\u7269\u3001\u521d\u59cb\u4eba\u6570\u3001\u5230\u8fbe\u8fc7\u7a0b\u3001\u5165\u53e3\u548c\u76ee\u7684\u5730\uff0c\u4e0d\u53e6\u5411\u7528\u6237\u7d22\u8981\u4e00\u5957\u573a\u5730\u8d44\u6599\u3002", "outputs": ["\u9010\u4eba\u7684\u91c7\u6837\u4f4d\u7f6e\u548c\u901f\u5ea6\u53d8\u5316", "\u6309\u5171\u540c\u7f51\u683c\u6c47\u603b\u7684\u5bc6\u5ea6\u4e0e\u4eba\u6570", "\u5165\u53e3\u5916\u6392\u961f\u3001\u901a\u9053\u6d41\u91cf\u548c\u7d2f\u8ba1\u79bb\u573a\u91cf\uff1b\u4e0d\u8f93\u51fa\u53ef\u4fe1\u7684\u4eba\u4f53\u6324\u538b\u529b\u6216\u4f24\u5bb3\u9884\u6d4b"], "parameter_keys": ["agent_radius_m", "sfm_reaction_time_s"], "tradeoff": "\u53c2\u6570\u5bf9\u5c40\u90e8\u8fd0\u52a8\u5f71\u54cd\u8f83\u5927\uff0c\u590d\u6742\u4e0d\u4ee3\u8868\u66f4\u51c6\u786e\u3002\u672c\u7248\u4f7f\u7528 JuPedSim \u7684\u5e73\u6ed1\u6392\u65a5\u5b9e\u73b0\uff1b\u201c\u793e\u4f1a\u529b\u201d\u4e0d\u80fd\u89e3\u91ca\u6210\u771f\u5b9e\u63a5\u89e6\u529b\uff0c\u4e0d\u80fd\u636e\u6b64\u9884\u6d4b\u8e29\u8e0f\u4f24\u4ea1\u3002", "citation": "Helbing & Moln\u00e1r (1995), Social force model for pedestrian dynamics, Physical Review E 51, 4282\u20134286."}], "status": "queued", "created_at": "2026-11-05T16:44:20.410532+00:00", "updated_at": "2026-11-05T16:44:20.410540+00:00", "lease_expires_at": "2026-11-05T16:47:20.410542+00:00"}}