# Copy this file to .env in the repository root and fill in your credentials.
# The data service reads .env; environment variables override its values.
# Per-model/per-repetition computation budgets, not research-duration limits.
# Server administrators may tune these after load tests; restart to apply.
CROWDSIM_MICRO_MAX_ACTIVE=3000
CROWDSIM_MICRO_MAX_AGENT_STEPS=2000000000
CROWDSIM_MICRO_MAX_SECONDS=1800
CROWDSIM_MICRO_MAX_SAVED_POSITIONS=500000
CROWDSIM_MONGO_HOST=127.0.0.1
CROWDSIM_MONGO_PORT=27018
CROWDSIM_MONGO_DATABASE=crowdsim
CROWDSIM_MONGO_AUTH_SOURCE=admin
CROWDSIM_MONGO_USERNAME=user
CROWDSIM_MONGO_PASSWORD=
# Alternatively set CROWDSIM_MONGO_URI (takes precedence over host/auth settings).

# Unified launcher: SSH settings for the database and model local forwards.
# Existing working connections are reused. SSH passwords are never stored here.
CROWDSIM_DB_SSH_HOST=211.81.55.186
CROWDSIM_DB_SSH_PORT=3000
CROWDSIM_DB_SSH_USER=hyq
CROWDSIM_DB_REMOTE_HOST=127.0.0.1
CROWDSIM_DB_REMOTE_PORT=27018
CROWDSIM_MODEL_SSH_HOST=211.81.55.186
CROWDSIM_MODEL_SSH_PORT=3000
CROWDSIM_MODEL_SSH_USER=hyq
CROWDSIM_MODEL_REMOTE_HOST=127.0.0.1
CROWDSIM_MODEL_REMOTE_PORT=8800
# Additional models use the same CROWDSIM_MODEL_SSH_* destination.
CROWDSIM_GLM_MAIN_LOCAL_PORT=8800
CROWDSIM_GLM_MAIN_REMOTE_PORT=8800
CROWDSIM_GLM_MAIN_MODEL=GLM-5.3-Flash
# The older Tabby instance remains independently configurable on 8899.
CROWDSIM_GLM_LOCAL_PORT=8899
CROWDSIM_GLM_REMOTE_PORT=8899
CROWDSIM_GLM_MODEL=GLM-5.3-Flash-exl3-4.05bpw
CROWDSIM_DIFFUSIONGEMMA_LOCAL_PORT=8500
CROWDSIM_DIFFUSIONGEMMA_REMOTE_PORT=8500
CROWDSIM_DIFFUSIONGEMMA_MODEL=diffusiongemma-26B-A4B-it:q4
# Optional per-model authentication (backend only; never sent to the browser).
# CROWDSIM_GLM_MAIN_API_KEY=  # Defaults to CROWDSIM_MODEL_API_KEY.
# CROWDSIM_GLM_API_KEY=
# CROWDSIM_DIFFUSIONGEMMA_API_KEY=
# CROWDSIM_QWEN_API_KEY=  # Defaults to CROWDSIM_MODEL_API_KEY.
# Optional CROWDSIM_GLM_MAIN_BASE_URL / CROWDSIM_QWEN_BASE_URL / CROWDSIM_GLM_BASE_URL /
# CROWDSIM_DIFFUSIONGEMMA_BASE_URL override the local OpenAI-compatible URLs.
# Optional existing SSH key path (default: OpenSSH standard keys / ssh-agent).
# CROWDSIM_SSH_IDENTITY_FILE=
# Optional model API key used by the launcher's /v1/models health probe.
# CROWDSIM_MODEL_API_KEY=

# Shared data-service model adapter (OpenAI-compatible; used by PDF parsing).
# Change these settings to switch models without editing import code.
CROWDSIM_LLM_BASE_URL=http://127.0.0.1:8800/v1
CROWDSIM_LLM_MODEL=GLM-5.3-Flash
# Optional post-review public-source search (Tavily-compatible JSON API).
# Without this key, PostAgent can still read public URLs supplied by the user.
CROWDSIM_POST_SEARCH_URL=https://api.tavily.com/search
CROWDSIM_POST_SEARCH_API_KEY=
# Qwen-specific options live in configuration; set {} for other providers.
CROWDSIM_LLM_EXTRA_BODY={}
# Post-review datasets, calibration targets, plans and experiment records use this
# MongoDB database; uploaded source files are stored in the postanalysis_files GridFS bucket.

# Optional structured current road conditions (advanced AMap Web service).
# The frontend JS map key is a different credential type.
CROWDSIM_AMAP_WEB_KEY=
# Only if the Web key was configured to require request signatures:
CROWDSIM_AMAP_WEB_PRIVATE_KEY=

# During-only fallback; independent of GLM and all pre/post providers.
CROWDSIM_DURING_DEEPSEEK_ENABLED=false
CROWDSIM_DURING_DEEPSEEK_BASE_URL=https://api.deepseek.com
CROWDSIM_DURING_DEEPSEEK_MODEL=deepseek-flash
CROWDSIM_DURING_DEEPSEEK_API_KEY=
# 可选 HTTP/HTTPS 代理；仅影响事中 DeepSeek，留空直接连接。
CROWDSIM_DURING_DEEPSEEK_PROXY=
CROWDSIM_DURING_DEEPSEEK_DECISION_TIMEOUT=8
